/* ===========================
   Ideias Comuns — style.css
   Premium Dark Redesign
=========================== */

:root {
  /* Backgrounds */
  --ink:        #05060b;
  --ink-1:      #0b0d14;
  --ink-2:      #0f1119;
  --ink-3:      #141820;
  --ink-4:      #191e29;

  /* Accent */
  --red:        #c8281f;
  --red-dark:   #a01e17;
  --red-glow:   rgba(200,40,31,0.12);

  /* Text */
  --white:      #eef0f6;
  --silver:     #7c8699;
  --dim:        rgba(238,240,246,0.32);

  /* Borders */
  --line:       rgba(255,255,255,0.06);
  --line-mid:   rgba(255,255,255,0.10);
  --line-strong:rgba(255,255,255,0.16);

  /* Misc */
  --nav-h:      72px;
  --r:          0px;
  --ease:       0.28s cubic-bezier(0.4,0,0.2,1);
  --font-display: 'Syne', sans-serif;
  --font-body:    'Inter', sans-serif;
  --font-label:   'Rajdhani', sans-serif;
}

/* ── RESET ── */
*,*::before,*::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--ink-1);
  color: var(--silver);
  line-height: 1.6;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
ul { list-style: none; }
img { max-width: 100%; display: block; }

/* ── CUSTOM SCROLLBAR ── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--ink); }
::-webkit-scrollbar-thumb { background: var(--red); border-radius: 3px; }

/* ── ANIMATIONS ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: none; }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.au { opacity: 0; animation: fadeUp 0.8s forwards; }
.ai { opacity: 0; animation: fadeIn 0.8s forwards; }

.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.in-view { opacity: 1; transform: none; }

/* ── NAV ── */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 999;
  height: var(--nav-h);
  background: rgba(5,6,11,0.9);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--line);
  transition: background var(--ease);
}
.nav.scrolled { background: rgba(5,6,11,0.98); }
.nav-inner {
  max-width: 1300px; margin: auto; height: 100%;
  display: flex; align-items: center; gap: 2rem;
  padding: 0 2rem;
}
.logo { display: flex; align-items: center; gap: .75rem; flex-shrink: 0; }
.logo img.logo-img { height: 40px; width: auto; object-fit: contain; }
.logo-text-wrap { display: flex; flex-direction: column; line-height: 1.1; }
.logo-name {
  font-family: var(--font-display);
  font-size: 1.1rem; font-weight: 700;
  color: var(--white); letter-spacing: .02em;
}
.logo-tagline {
  font-family: var(--font-label);
  font-size: .55rem; font-weight: 700;
  color: var(--red); letter-spacing: .22em; text-transform: uppercase;
}
.nav-links { display: flex; gap: 2rem; margin-left: auto; }
.nav-links a {
  font-family: var(--font-label);
  font-size: .78rem; font-weight: 600;
  color: rgba(238,240,246,0.45);
  letter-spacing: .14em; text-transform: uppercase;
  transition: color var(--ease);
  position: relative;
}
.nav-links a:hover { color: var(--white); }
.nav-links a.active-link { color: var(--white); }
.nav-links a.active-link::after {
  content: '';
  position: absolute; bottom: -4px; left: 0; right: 0;
  height: 2px; background: var(--red);
}
.nav-actions { display: flex; align-items: center; gap: .75rem; }
.btn-nav {
  background: var(--red); color: #fff;
  padding: .55rem 1.5rem;
  font-family: var(--font-label); font-size: .78rem; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase;
  transition: background var(--ease);
  white-space: nowrap; flex-shrink: 0;
}
.btn-nav:hover { background: var(--red-dark); }
.hamburger {
  display: none; flex-direction: column; gap: 5px;
  background: none; border: none; cursor: pointer; padding: 4px; margin-left: auto;
}
.hamburger span { display: block; width: 22px; height: 2px; background: var(--white); transition: var(--ease); }

/* ── HERO ── */
.hero {
  min-height: 100vh; position: relative;
  display: flex; align-items: center; overflow: hidden;
}
.hero-photo {
  position: absolute; inset: 0;
  background: url('https://ideiascomuns.pt/wp-content/uploads/2024/07/modern-glass-wall-commercial-buildings-lobby-hall.jpg') center/cover no-repeat;
  opacity: 0.25;
}
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(120deg, rgba(5,6,11,0.97) 0%, rgba(5,6,11,0.88) 50%, rgba(5,6,11,0.5) 100%);
}
.hero-stripe {
  position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(to bottom, transparent, var(--red), transparent);
  z-index: 2;
}
.hero-accent-lines {
  position: absolute; inset: 0; pointer-events: none; z-index: 1;
}
.hero-accent-lines span {
  position: absolute; top: 0; bottom: 0; width: 1px;
  background: var(--line);
}
.hero-accent-lines span:nth-child(1) { left: 33%; }
.hero-accent-lines span:nth-child(2) { left: 66%; }
.hero-accent-lines span:nth-child(3) { left: 95%; }
.hero-inner {
  position: relative; z-index: 2;
  max-width: 1300px; margin: auto; width: 100%;
  display: grid; grid-template-columns: 1.2fr 380px;
  gap: 4rem; align-items: center;
  padding: calc(var(--nav-h) + 8rem) 2rem 6rem;
  min-height: 100vh;
}
.hero-kicker {
  display: flex; align-items: center; gap: .9rem;
  margin-bottom: 2rem;
}
.hero-kicker-bar { width: 28px; height: 1px; background: var(--red); flex-shrink: 0; }
.hero-kicker-txt {
  font-family: var(--font-label);
  font-size: .65rem; font-weight: 700;
  color: var(--red); letter-spacing: .24em; text-transform: uppercase;
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(3.2rem, 6vw, 5.8rem);
  font-weight: 700; line-height: 0.92;
  letter-spacing: -.02em; color: var(--white);
  margin-bottom: 1.75rem;
}
.hero-title .dim {
  font-family: var(--font-body);
  font-weight: 300;
  color: var(--dim);
  display: block;
  font-size: 0.5em;
  margin-bottom: 0.3em;
}
.hero-title .accent { color: var(--red); }
.hero-sub {
  font-family: var(--font-body);
  font-size: 1rem; color: var(--dim);
  line-height: 1.9; max-width: 460px;
  margin-bottom: 2.5rem;
}
.hero-ctas {
  display: flex; gap: .9rem; flex-wrap: wrap;
  margin-bottom: 3rem;
}
.hero-stats { display: flex; gap: 3rem; align-items: center; }
.stat strong {
  display: block;
  font-family: var(--font-display);
  font-size: 2.2rem; font-weight: 700;
  color: var(--white); line-height: 1; margin-bottom: .25rem;
}
.stat span {
  font-family: var(--font-body);
  font-size: .68rem; color: var(--silver);
  text-transform: uppercase; letter-spacing: .1em;
}
.stat-div { width: 1px; background: var(--line-mid); align-self: stretch; }

/* Hero panel */
.hero-panel {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line-mid);
  backdrop-filter: blur(8px);
  padding: 2rem;
}
.hero-panel h3 {
  font-family: var(--font-label);
  font-size: .7rem; font-weight: 700;
  color: var(--silver); letter-spacing: .2em; text-transform: uppercase;
  margin-bottom: 1.25rem;
  border-bottom: 1px solid var(--line); padding-bottom: .75rem;
}
.panel-items { display: flex; flex-direction: column; gap: .6rem; }
.panel-item {
  display: flex; align-items: center; gap: .9rem;
  padding: .9rem 1.1rem;
  border-left: 2px solid var(--red);
  background: rgba(200,40,31,0.05);
  transition: background var(--ease);
}
.panel-item:hover { background: rgba(200,40,31,0.1); }
.panel-item-icon { display: flex; align-items: center; flex-shrink: 0; }
.panel-item strong {
  display: block;
  font-family: var(--font-display);
  font-size: .88rem; font-weight: 700; color: var(--white);
  margin-bottom: .1rem;
}
.panel-item span {
  font-family: var(--font-body);
  font-size: .74rem; color: var(--silver);
}

/* ── BUTTONS ── */
.btn-primary {
  display: inline-flex; align-items: center; gap: .55rem;
  background: var(--red); color: #fff;
  padding: .82rem 1.9rem;
  font-family: var(--font-label); font-size: .88rem; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase;
  transition: background var(--ease), transform var(--ease);
  border: none; cursor: pointer;
}
.btn-primary:hover { background: var(--red-dark); transform: translateY(-2px); }
.btn-outline {
  display: inline-flex; align-items: center; gap: .5rem;
  background: transparent; color: rgba(238,240,246,0.6);
  border: 1px solid var(--line-strong);
  padding: .82rem 1.7rem;
  font-family: var(--font-label); font-size: .88rem; font-weight: 600;
  letter-spacing: .12em; text-transform: uppercase;
  transition: all var(--ease); cursor: pointer;
}
.btn-outline:hover { border-color: rgba(238,240,246,0.5); color: var(--white); }
.btn-outline.dark { color: var(--silver); border-color: var(--line-strong); }
.btn-outline.dark:hover { border-color: var(--red); color: var(--red); }

/* ── LAYOUT BASE ── */
.section { background: var(--ink-1); padding: 7rem 0; }
.section-dark { background: var(--ink); padding: 7rem 0; }
.section-mid { background: var(--ink-3); padding: 7rem 0; }
.section-tinted { background: var(--ink-2); padding: 7rem 0; }
.container { max-width: 1300px; margin: auto; padding: 0 2rem; }

/* ── KICKERS & SECTION HEADERS ── */
.kicker { display: flex; align-items: center; gap: .9rem; margin-bottom: .9rem; }
.kicker-bar { width: 28px; height: 1px; background: var(--red); flex-shrink: 0; }
.kicker-txt {
  font-family: var(--font-label);
  font-size: .65rem; font-weight: 700;
  color: var(--red); letter-spacing: .24em; text-transform: uppercase;
}
.sec-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 700; line-height: 1;
  letter-spacing: -.01em;
  color: var(--white);
  margin-bottom: 1rem;
}
.sec-sub {
  font-family: var(--font-body);
  font-size: .95rem; color: var(--silver);
  max-width: 520px; line-height: 1.85;
}

/* ── EMPRESA ── */
.empresa-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 6rem; align-items: center;
}
.empresa-photo-wrap { position: relative; }
.empresa-photo-wrap::before {
  content: '';
  position: absolute;
  top: -12px; left: -12px; right: 40px; bottom: 40px;
  border: 1px solid var(--red);
  opacity: 0.3; z-index: 0;
}
.empresa-photo {
  width: 100%; aspect-ratio: 4/3; object-fit: cover;
  filter: grayscale(10%);
  position: relative; z-index: 1;
}
.empresa-photo-fallback {
  width: 100%; aspect-ratio: 4/3;
  background: linear-gradient(135deg, var(--ink-3), var(--ink));
  display: flex; align-items: center; justify-content: center;
  font-size: 4rem; border: 1px solid var(--line);
  position: relative; z-index: 1;
}
.empresa-since {
  display: flex; align-items: center; gap: 1rem;
  margin-bottom: 1.25rem;
  padding: .9rem 1.5rem;
  background: var(--red);
  width: fit-content;
}
.empresa-since-year {
  font-family: var(--font-display);
  font-size: 2rem; font-weight: 700;
  color: #fff; line-height: 1;
}
.empresa-since-label {
  font-family: var(--font-label);
  font-size: .7rem; font-weight: 600;
  color: rgba(255,255,255,.75); letter-spacing: .1em; text-transform: uppercase;
  line-height: 1.4;
}
.empresa-text {
  font-family: var(--font-body);
  color: var(--silver); line-height: 1.85;
  margin-bottom: 1.25rem; font-size: .95rem;
}
.empresa-feats { margin-top: 2rem; display: flex; flex-direction: column; gap: .65rem; }
.empresa-feat {
  display: flex; align-items: center; gap: .9rem;
  padding: .85rem 1rem;
  border-left: 2px solid var(--red);
  background: rgba(200,40,31,0.06);
}
.empresa-feat span { font-size: 1rem; flex-shrink: 0; }
.empresa-feat strong {
  font-family: var(--font-label);
  font-size: .88rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: .04em;
  color: var(--white);
}
.empresa-logos {
  display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;
  margin-top: 2.5rem; padding-top: 2rem;
  border-top: 1px solid var(--line);
}
.empresa-logo-badge img {
  height: 40px; width: auto; object-fit: contain;
  filter: brightness(0) invert(1); opacity: .2;
  transition: all var(--ease);
}
.empresa-logo-badge img:hover { opacity: .6; }

/* ── SERVIÇOS ── */
.services-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--line);
  margin-top: 3.5rem;
}
.service-card {
  background: var(--ink-2); padding: 2.5rem;
  position: relative; overflow: hidden;
  transition: background var(--ease);
}
.service-card::after {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: var(--red);
  transform: scaleX(0); transform-origin: left;
  transition: transform .35s ease;
}
.service-card:hover::after { transform: scaleX(1); }
.service-card:hover { background: var(--ink-3); }
.service-card.featured { background: rgba(200,40,31,0.07); }
.service-card.featured::after { transform: scaleX(1); }
.svc-num {
  position: absolute; top: 1rem; right: 1.5rem;
  font-family: var(--font-display);
  font-size: 5rem; font-weight: 800;
  color: rgba(255,255,255,0.025); line-height: 1;
}
.svc-icon { margin-bottom: 1.1rem; }
.svc-icon img { height: 44px; width: auto; filter: brightness(0) invert(1); opacity: .6; }
.svc-icon-emoji { font-size: 1.75rem; }
.service-card h3 {
  font-family: var(--font-display);
  font-size: 1.1rem; font-weight: 700;
  color: var(--white); text-transform: uppercase;
  letter-spacing: .04em; margin-bottom: .65rem;
}
.service-card.featured h3 { color: var(--white); }
.service-card p {
  font-family: var(--font-body);
  font-size: .84rem; color: var(--silver);
  line-height: 1.8; margin-bottom: 1.1rem;
}
.service-card ul { display: flex; flex-direction: column; gap: .35rem; }
.service-card li {
  font-family: var(--font-body);
  font-size: .8rem; color: rgba(238,240,246,0.3);
  padding-left: .9rem; position: relative;
}
.service-card li::before {
  content: '—'; position: absolute; left: 0;
  color: var(--red); font-weight: 700;
}
.svc-link {
  display: inline-flex; align-items: center; gap: .4rem;
  font-family: var(--font-label);
  font-size: .72rem; font-weight: 700;
  color: var(--red); text-transform: uppercase;
  letter-spacing: .14em; margin-top: 1.4rem;
  transition: gap var(--ease);
}
.svc-link:hover { gap: .75rem; }
.svc-badge {
  position: absolute; top: .9rem; right: .9rem;
  background: var(--red); color: #fff;
  font-family: var(--font-label); font-size: .6rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  padding: .2rem .6rem;
}

/* ── EQUIPAMENTOS ── */
.equip-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 2px; background: var(--line);
  border: 1px solid var(--line);
  margin-top: 3rem;
}
.equip-card {
  background: var(--ink-3);
  position: relative; overflow: hidden;
  display: grid; grid-template-columns: 1fr 1fr;
  min-height: 220px;
}
.equip-card.wide { grid-column: 1/-1; grid-template-columns: 420px 1fr; }
.equip-card-img {
  position: relative; overflow: hidden;
  background: var(--ink); flex-shrink: 0; cursor: pointer;
}
.equip-card-img img {
  width: 100%; height: 100%; object-fit: cover;
  filter: grayscale(20%); opacity: .85;
  transition: all .45s ease; display: block;
}
.equip-card:hover .equip-card-img img {
  filter: grayscale(0%); opacity: 1; transform: scale(1.04);
}
.equip-card-body {
  padding: 2rem 2.25rem;
  display: flex; flex-direction: column; justify-content: center;
  border-left: 2px solid var(--red);
}
.equip-card-tag {
  font-family: var(--font-label);
  font-size: .62rem; font-weight: 700;
  color: var(--red); letter-spacing: .2em; text-transform: uppercase;
  margin-bottom: .6rem;
}
.equip-card-body h4 {
  font-family: var(--font-display);
  font-size: 1.4rem; font-weight: 700;
  color: var(--white); text-transform: uppercase;
  letter-spacing: .03em; line-height: 1.1; margin-bottom: .75rem;
}
.equip-card-body p {
  font-family: var(--font-body);
  font-size: .88rem; color: var(--silver);
  line-height: 1.75; margin-bottom: 1rem;
}
.equip-spec { display: flex; flex-wrap: wrap; gap: .5rem; }
.equip-spec-pill {
  font-family: var(--font-label); font-size: .7rem; font-weight: 600;
  color: var(--silver);
  border: 1px solid var(--line-strong);
  padding: .25rem .7rem; letter-spacing: .06em; text-transform: uppercase;
}

/* ── PORTFÓLIO ── */
.portfolio-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--line);
  margin-top: 3rem;
}
.portfolio-item {
  position: relative; overflow: hidden;
  aspect-ratio: 3/2;
  background: var(--ink-3); cursor: pointer;
}
.portfolio-item img {
  width: 100%; height: 100%; object-fit: cover;
  filter: grayscale(30%); opacity: .85;
  transition: all .4s ease;
}
.portfolio-item:hover img {
  filter: grayscale(0%); opacity: 1; transform: scale(1.06);
}
.portfolio-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(5,6,11,.88) 0%, rgba(5,6,11,.15) 60%, transparent 100%);
  opacity: .75;
  transition: opacity .35s ease;
  display: flex; align-items: flex-end; padding: 1.5rem;
}
.portfolio-item:hover .portfolio-overlay { opacity: 1; }
.portfolio-overlay h4 {
  font-family: var(--font-display);
  font-size: .95rem; font-weight: 700;
  color: var(--white); text-transform: uppercase; letter-spacing: .04em;
}
.portfolio-overlay p {
  font-family: var(--font-body);
  font-size: .78rem; color: rgba(238,240,246,0.55); margin-top: .2rem;
}

/* ── MARCAS (marquee) ── */
.brands-track-wrap {
  margin-top: 3rem; overflow: hidden;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  position: relative; padding: 2.25rem 0;
}
.brands-track-wrap::before,
.brands-track-wrap::after {
  content: ''; position: absolute; top: 0; bottom: 0; width: 120px; z-index: 2;
  pointer-events: none;
}
.brands-track-wrap::before {
  left: 0;
  background: linear-gradient(to right, var(--ink), transparent);
}
.brands-track-wrap::after {
  right: 0;
  background: linear-gradient(to left, var(--ink), transparent);
}
.brands-track {
  display: flex; align-items: center; gap: 0;
  width: max-content;
  animation: marquee 28s linear infinite;
}
.brands-track:hover { animation-play-state: paused; }
.brand-item {
  display: flex; align-items: center; justify-content: center;
  padding: 0 3.5rem;
  border-right: 1px solid var(--line);
  flex-shrink: 0;
  transition: all var(--ease);
}
.brand-item img {
  height: 46px; width: auto; max-width: 140px;
  object-fit: contain;
  filter: grayscale(100%) brightness(0) invert(1);
  opacity: .25;
  transition: all .35s ease;
}
.brands-track:hover .brand-item:hover img {
  opacity: .7;
  filter: grayscale(0%) brightness(1) invert(0);
  transform: scale(1.08);
}

/* ── COMO FUNCIONA ── */
.steps-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  position: relative; margin-top: 3.5rem; gap: 0;
}
.steps-grid::before {
  content: ''; position: absolute;
  top: 46px; left: 0; right: 0; height: 1px;
  background: var(--line-mid);
}
.step-item { padding: 0 2rem 0 0; position: relative; }
.step-num {
  font-family: var(--font-label);
  font-size: .65rem; font-weight: 700;
  color: var(--red); letter-spacing: .2em; text-transform: uppercase;
  margin-bottom: .4rem;
}
.step-dot {
  width: 48px; height: 48px;
  border-radius: 50%;
  background: var(--ink-3); border: 1px solid var(--line-strong);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-size: 1.1rem; font-weight: 700;
  color: var(--white); position: relative; z-index: 1; margin-bottom: 1.5rem;
}
.step-item.active .step-dot {
  background: var(--red); border-color: var(--red);
}
.step-item h4 {
  font-family: var(--font-display);
  font-size: 1rem; font-weight: 700;
  color: var(--white); text-transform: uppercase;
  letter-spacing: .04em; margin-bottom: .65rem;
}
.step-item p {
  font-family: var(--font-body);
  font-size: .84rem; color: var(--silver); line-height: 1.75;
}

/* ── FORMULÁRIO ── */
.form-wrapper {
  max-width: 780px; margin: 3.5rem auto 0;
  background: var(--ink-2);
  border: 1px solid var(--line-mid);
  padding: 3.5rem;
}
.stepper {
  display: flex; align-items: center;
  margin-bottom: 2.5rem; padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--line-mid);
}
.step-it {
  display: flex; align-items: center; gap: .6rem;
  font-family: var(--font-label); font-size: .75rem; font-weight: 600;
  color: var(--silver); letter-spacing: .1em; text-transform: uppercase;
}
.step-it.active { color: var(--red); }
.step-it.done { color: var(--silver); }
.step-dot-sm {
  width: 28px; height: 28px;
  background: var(--ink-3); border: 2px solid var(--line-mid);
  display: flex; align-items: center; justify-content: center;
  font-size: .78rem; font-weight: 700; color: var(--silver); flex-shrink: 0;
}
.step-it.active .step-dot-sm {
  background: var(--red); border-color: var(--red); color: #fff;
}
.step-it.done .step-dot-sm { border-color: var(--red); color: var(--red); }
.step-ln { flex: 1; height: 1px; background: var(--line-mid); }
.form-step { display: none; }
.form-step.active { display: block; }
.form-step-title {
  font-family: var(--font-display);
  font-size: 1.25rem; font-weight: 700;
  color: var(--white);
  text-transform: uppercase; letter-spacing: .04em; margin-bottom: 1.75rem;
}
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
.field { display: flex; flex-direction: column; gap: .4rem; }
.field.full { grid-column: 1/-1; }
label {
  font-family: var(--font-label); font-size: .65rem; font-weight: 700;
  color: var(--silver); letter-spacing: .16em; text-transform: uppercase;
}
input, textarea, select {
  width: 100%;
  border: 1px solid var(--line-mid);
  background: var(--ink-3);
  border-radius: 0;
  padding: .85rem 1.1rem;
  font-family: var(--font-body); font-size: .95rem;
  color: var(--white);
  outline: none; transition: border-color var(--ease);
  -webkit-appearance: none;
}
input:focus, textarea:focus, select:focus { border-color: var(--red); }
select option { background: var(--ink-3); color: var(--white); }
textarea { resize: vertical; min-height: 100px; }
.form-nav {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 2rem; padding-top: 1.5rem;
  border-top: 1px solid var(--line-mid);
}
.btn-back {
  display: inline-flex; align-items: center; gap: .4rem;
  background: transparent; color: var(--silver);
  border: 1px solid var(--line-strong);
  padding: .75rem 1.5rem;
  font-family: var(--font-label); font-size: .82rem; font-weight: 600;
  letter-spacing: .1em; text-transform: uppercase;
  cursor: pointer; transition: all var(--ease);
}
.btn-back:hover { border-color: var(--red); color: var(--red); }
.btn-next, .btn-submit { padding: .85rem 2rem; }
.svc-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
.svc-opt input { display: none; }
.opt-card {
  display: flex; flex-direction: column; align-items: center; gap: .5rem;
  padding: 1.25rem 1rem;
  border: 1px solid var(--line-mid);
  background: var(--ink-3);
  cursor: pointer; transition: all var(--ease); text-align: center;
}
.opt-card:hover { border-color: var(--red); background: var(--red-glow); }
.svc-opt input:checked + .opt-card {
  border-color: var(--red); background: var(--red-glow);
}
.opt-icon { font-size: 1.4rem; }
.opt-label {
  font-family: var(--font-label); font-size: .8rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: .05em; color: var(--white);
}
.sub-opts { margin-top: 1.25rem; }
.fl {
  font-family: var(--font-label); font-size: .7rem; font-weight: 600;
  color: var(--silver); letter-spacing: .14em; text-transform: uppercase;
  margin-bottom: .65rem; display: block;
}
.sub-grid { display: flex; flex-wrap: wrap; gap: .5rem; }
.sub-chip {
  padding: .4rem .9rem;
  border: 1px solid var(--line-mid);
  background: var(--ink-3);
  font-family: var(--font-label); font-size: .75rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: .06em;
  cursor: pointer; transition: all var(--ease); color: var(--silver);
}
.sub-chip:hover, .sub-chip.selected {
  border-color: var(--red); background: var(--red); color: #fff;
}
.upload-zone {
  border: 2px dashed var(--line-strong); padding: 2rem;
  text-align: center; cursor: pointer;
  background: var(--ink-3);
  transition: all var(--ease);
}
.upload-zone:hover, .upload-zone.drag-over {
  border-color: var(--red); background: var(--red-glow);
}
.upload-inner { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
.upload-icon { font-size: 2rem; }
.upload-inner > span { font-size: .9rem; color: var(--silver); }
.upload-inner small { font-size: .75rem; color: var(--silver); opacity: .6; }
.upload-previews { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
.preview-img { width: 80px; height: 80px; object-fit: cover; border: 1px solid var(--line-mid); }
.summary-card {
  background: var(--ink-3); padding: 1.5rem;
  border-left: 2px solid var(--red);
}
.summary-row {
  display: flex; gap: 1rem; padding: .5rem 0;
  border-bottom: 1px solid var(--line); font-size: .9rem;
  color: var(--white);
}
.summary-row:last-child { border-bottom: none; }
.summary-lbl {
  font-family: var(--font-label); font-weight: 700; font-size: .72rem;
  color: var(--silver); text-transform: uppercase;
  letter-spacing: .1em; min-width: 120px;
}
.checkbox-wrap { display: flex; align-items: flex-start; gap: .75rem; cursor: pointer; }
.checkbox-wrap input { width: auto; margin-top: .2rem; accent-color: var(--red); }
.checkbox-wrap span {
  font-family: var(--font-body);
  font-size: .87rem; color: var(--silver); line-height: 1.55;
}
.checkbox-wrap a { color: var(--red); text-decoration: underline; }
.success-panel {
  text-align: center; padding: 3rem 2rem;
  display: flex; flex-direction: column;
  align-items: center; gap: 1rem;
}
.success-icon { font-size: 3rem; }
.success-panel h3 {
  font-family: var(--font-display);
  font-size: 2rem; font-weight: 700;
  text-transform: uppercase; color: var(--white);
}
.success-panel p {
  font-family: var(--font-body);
  color: var(--silver); max-width: 400px; line-height: 1.7;
}
.success-sub { font-size: .85rem; }

/* ── CONTACTO ── */
.contact-grid {
  display: grid; grid-template-columns: 1fr 360px;
  gap: 4rem; align-items: start; margin-top: 3.5rem;
}
.contact-items { display: flex; flex-direction: column; gap: 1.4rem; }
.contact-item { display: flex; align-items: flex-start; gap: 1.1rem; }
.contact-icon {
  width: 44px; height: 44px; flex-shrink: 0;
  background: rgba(200,40,31,0.08);
  border: 1px solid rgba(200,40,31,0.2);
  display: flex; align-items: center; justify-content: center;
}
.contact-icon svg { opacity: .7; }
.contact-item strong {
  display: block;
  font-family: var(--font-label); font-size: .65rem; font-weight: 700;
  color: var(--silver); letter-spacing: .18em; text-transform: uppercase;
  margin-bottom: .3rem;
}
.contact-item a, .contact-item span {
  font-family: var(--font-body);
  font-size: .97rem; color: rgba(238,240,246,0.65); line-height: 1.5;
}
.contact-item a { display: block; }
.contact-item a:hover { color: var(--white); }
.btn-wa {
  display: inline-flex; align-items: center; gap: .75rem;
  background: #25d366; color: #fff; padding: .9rem 2rem;
  font-family: var(--font-label); font-size: .88rem; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase; margin-top: 2rem;
  transition: background var(--ease), transform var(--ease);
}
.btn-wa:hover { background: #1fb358; transform: translateY(-2px); }
.contact-map {
  background: var(--ink-3); border: 1px solid var(--line-mid);
  padding: 2rem; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; gap: .65rem; min-height: 240px;
}
.contact-map .map-coords {
  font-family: var(--font-label);
  font-size: .6rem; font-weight: 600;
  color: var(--red); letter-spacing: .2em; text-transform: uppercase;
  margin-bottom: .5rem;
}
.contact-map h4 {
  font-family: var(--font-display);
  font-size: 1rem; font-weight: 700;
  color: var(--white); text-transform: uppercase; letter-spacing: .05em;
}
.contact-map p {
  font-family: var(--font-body);
  font-size: .8rem; color: var(--silver); line-height: 1.6;
}
.contact-map a {
  font-family: var(--font-label);
  font-size: .8rem; color: var(--red); margin-top: .5rem;
  border: 1px solid rgba(200,40,31,0.3); padding: .35rem .9rem;
  font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
  transition: all var(--ease);
}
.contact-map a:hover { background: var(--red); color: #fff; }

/* ── FOOTER ── */
.footer { background: var(--ink); border-top: 1px solid var(--line); padding: 2.5rem 0; }
.footer-inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; flex-wrap: wrap;
}
.footer p {
  font-family: var(--font-body);
  font-size: .75rem; color: rgba(238,240,246,0.18);
}
.footer-links { display: flex; gap: 1.5rem; }
.footer-links a {
  font-family: var(--font-label);
  font-size: .72rem; font-weight: 600;
  color: var(--silver); letter-spacing: .1em; text-transform: uppercase;
  transition: color var(--ease);
}
.footer-links a:hover { color: var(--white); }

/* ── FLOATING WA ── */
.wa-float {
  position: fixed; bottom: 2rem; right: 2rem; z-index: 998;
  width: 56px; height: 56px;
  background: #25d366; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 24px rgba(37,211,102,0.35);
  transition: transform var(--ease), box-shadow var(--ease);
}
.wa-float:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 32px rgba(37,211,102,0.5);
}

/* ── MOBILE NAV OPEN ── */
.nav-links.open {
  display: flex; flex-direction: column; gap: 0;
  position: absolute; top: var(--nav-h); left: 0; right: 0;
  background: rgba(5,6,11,0.98);
  padding: 1.5rem; border-bottom: 1px solid var(--line);
}
.nav-links.open a {
  padding: .65rem 0; border-bottom: 1px solid var(--line); font-size: .9rem;
}

/* ── TOAST ── */
.toast {
  position: fixed; right: 18px; bottom: 18px;
  display: flex; align-items: center; gap: .75rem;
  padding: 1rem 1.1rem;
  background: var(--ink-4); color: var(--white);
  border: 1px solid var(--line-mid);
  box-shadow: 0 18px 60px rgba(0,0,0,.4);
  transform: translateY(120%); transition: transform .25s ease, opacity .25s ease;
  opacity: 0; z-index: 1200;
}
.toast.show { transform: translateY(0); opacity: 1; }
.toast.warn { border-color: var(--red); }

/* ── LIGHTBOX ── */
.lightbox {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.88);
  display: none; align-items: center; justify-content: center;
  padding: 1rem; z-index: 1300;
}
.lightbox.open { display: flex; }
.lightbox-box { max-width: min(1100px, 92vw); }
.lightbox-box h4 {
  font-family: var(--font-display);
  color: var(--white); margin: 0 0 .8rem;
  letter-spacing: .06em; text-transform: uppercase;
}
.lightbox-box img { max-width: 100%; max-height: 80vh; }
.lightbox-close {
  position: absolute; top: 18px; right: 18px;
  width: 42px; height: 42px; border: 1px solid var(--line-strong);
  background: var(--ink-4); color: var(--white);
  font-size: 1.8rem; cursor: pointer;
}

/* ── MISC ── */
.field-grid-inline { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

/* ── RESPONSIVE ── */
@media (max-width: 1100px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-panel { display: none; }
  .empresa-grid { grid-template-columns: 1fr; gap: 3rem; }
  .services-grid { grid-template-columns: repeat(2, 1fr); }
  .equip-grid { grid-template-columns: 1fr; }
  .equip-card, .equip-card.wide {
    grid-column: auto; grid-template-columns: 200px 1fr;
  }
  .steps-grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  .steps-grid::before { display: none; }
  .contact-grid { grid-template-columns: 1fr; }
  .portfolio-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .nav-links, .btn-nav { display: none; }
  .hamburger { display: flex; }
  .services-grid, .portfolio-grid { grid-template-columns: 1fr; }
  .equip-grid { grid-template-columns: 1fr; }
  .equip-card, .equip-card.wide {
    grid-column: auto; grid-template-columns: 1fr; min-height: auto;
  }
  .equip-card-img img { aspect-ratio: 16/9; height: 220px; width: 100%; }
  .equip-card-body {
    border-left: none; border-top: 2px solid var(--red); padding: 1.5rem;
  }
  .field-grid { grid-template-columns: 1fr; }
  .svc-opts { grid-template-columns: repeat(2, 1fr); }
  .steps-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-wrap: wrap; gap: 1.5rem; }
  .form-wrapper { padding: 1.5rem; }
  .stepper { display: none; }
  .field-grid-inline { grid-template-columns: 1fr; }
  .contact-map { min-height: 200px; }
}
