{
  "name": "vidromestre-webapp",
  "version": "1.0.0",
  "description": "VidroMestre — Web App de Pré-Atendimento para Serralheria & Vidraria",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm run build:joinery",
    "build:joinery": "tsc -p tsconfig.json",
    "build:joinery:tests": "tsc -p tsconfig.tests.json",
    "test:joinery": "npm run build:joinery && npm run build:joinery:tests && node --test .tmp-tests/tests"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "three": "^0.181.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
